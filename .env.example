# Markdox — Konwerter do Markdown (aplikacja bezstanowa, bez bazy danych)
#
# AI jest OPCJONALNE i przekazywane z frontendu per-request.
# Poniższe zmienne są opcjonalne i służą tylko do nadpisania domyślnych limitów.

# MAX_FILES=10
# MAX_UPLOAD_MB=25
# MAX_BATCH_MB=100
# DEFAULT_OCR_LANG=pol+eng

# Nieaktywne: próg pewności OCR nie jest dziś nigdzie odczytywany,
# bo pole ocr_confidence nie jest wypełniane. Zostawione pod przyszłą logikę.
# OCR_CONF_THRESHOLD=70

# Originy frontendu dopuszczone przez CORS (rozdzielone przecinkiem).
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Czy endpoint AI podany przez użytkownika może wskazywać na sieć prywatną.
# Wymagane przez tryb "Lokalne" (Ollama na loopbacku), gdy backend działa
# na maszynie użytkownika. PRZY WDROŻENIU PUBLICZNYM USTAW NA false.
# ALLOW_PRIVATE_AI_ENDPOINTS=true
